---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { SKILLS, EXPERIENCE, PROFILE } from '../data/resume';
import { path } from '../lib/paths';

// Served from public/, so replacing that file updates the download with no
// code change. Keep the public copy free of the phone number and home address.
const resumePdf = path('/Sean-Teare-Resume.pdf');
---

<Base
  title="Résumé — Sean Teare"
  description="Résumé of Sean Teare, Fellow Engineer and Technical Leader: 15+ years across cloud-native APIs, distributed systems, and engineering leadership."
>
  <main style="padding: 56px 0 0;">
    <div
      style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 20px; margin-bottom: 8px;"
    >
      <div>
        <h1
          style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(34px, 4.5vw, 48px); margin: 0 0 8px;"
        >
          Résumé
        </h1>
        <p style="font-size: 16px; margin: 0; color: color-mix(in srgb, var(--color-text) 78%, transparent);">
          Sean Teare — Fellow Engineer &amp; Technical Leader
        </p>
      </div>
      <a
        class="btn btn-primary"
        href={resumePdf}
        download
        style="display: inline-flex; align-items: center; gap: 8px; text-decoration: none;"
      >
        <Icon name="download" size={16} />
        Download PDF
      </a>
    </div>

    <div
      style="display: flex; gap: 18px; flex-wrap: wrap; margin: 20px 0 40px; font-size: 14.5px; color: color-mix(in srgb, var(--color-text) 78%, transparent);"
    >
      <a href="mailto:steare573@gmail.com" style="display: inline-flex; align-items: center; gap: 6px;">
        <Icon name="mail" size={15} />steare573@gmail.com
      </a>
      <a
        href="https://www.linkedin.com/in/sean-teare-4b166577/"
        target="_blank"
        rel="noopener"
        style="display: inline-flex; align-items: center; gap: 6px;"
      >
        <Icon name="linkedin" size={15} />linkedin.com/in/sean-teare-4b166577
      </a>
      <a
        href="https://github.com/steare573"
        target="_blank"
        rel="noopener"
        style="display: inline-flex; align-items: center; gap: 6px;"
      >
        <Icon name="github" size={15} />github.com/steare573
      </a>
    </div>

    <section style="margin-bottom: 44px;">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 22px; margin: 0 0 12px;">
        Profile
      </h2>
      <p
        style="font-size: 15.5px; line-height: 1.7; max-width: 78ch; margin: 0; color: color-mix(in srgb, var(--color-text) 85%, transparent);"
      >
        {PROFILE}
      </p>
    </section>

    <section style="margin-bottom: 44px;">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 22px; margin: 0 0 16px;">
        Technology &amp; Capabilities
      </h2>
      {
        SKILLS.map((grp) => (
          <div style="margin-bottom: 16px;">
            <div style="font-weight: 700; font-size: 14.5px; margin-bottom: 8px;">{grp.name}</div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px;">
              {grp.items.map((item) => (
                <span class={`tag ${grp.tagClass}`}>{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </section>

    <section style="margin-bottom: 44px;">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 22px; margin: 0 0 20px;">
        Professional Experience
      </h2>
      {
        EXPERIENCE.map((co) => (
          <div style="margin-bottom: 32px;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; margin-bottom: 4px;">
              <h3 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 19px; margin: 0;">
                {co.company}
              </h3>
              <span style="font-size: 13.5px; color: color-mix(in srgb, var(--color-text) 65%, transparent);">
                {co.location}
              </span>
            </div>
            {co.roles.map((role) => (
              <div style="margin: 14px 0 0 0; padding-left: 20px; border-left: 2px solid var(--color-neutral-200);">
                <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px;">
                  <div style="font-weight: 700; font-size: 15.5px;">{role.title}</div>
                  <div style="font-size: 13px; color: color-mix(in srgb, var(--color-text) 60%, transparent);">
                    {role.dates}
                  </div>
                </div>
                <ul style="margin: 10px 0 0; padding-left: 18px; font-size: 14.5px; line-height: 1.65; color: color-mix(in srgb, var(--color-text) 82%, transparent);">
                  {role.bullets.map((bullet) => (
                    <li style="margin-bottom: 6px;">{bullet}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ))
      }
    </section>

    <section style="margin-bottom: 40px;">
      <h2 style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: 22px; margin: 0 0 12px;">
        Education
      </h2>
      <p style="font-size: 15px; margin: 0;">
        <strong>Bachelor of Science, Computer Science</strong><br />University of North Carolina at
        Wilmington — Wilmington, NC | 2009
      </p>
    </section>
  </main>
</Base>

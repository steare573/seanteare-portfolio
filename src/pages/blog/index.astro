---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { path, monthYear } from '../../lib/paths';

// Drafts are visible while developing, hidden in production builds.
const posts = (
  await getCollection('blog', ({ data }) => (import.meta.env.PROD ? !data.draft : true))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base
  title="Field notes — Sean Teare"
  description="Occasional writing on agentic engineering, platform architecture, and leading teams through hard technical change."
>
  <main style="padding: 56px 0 0;">
    <h1
      style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(34px, 4.5vw, 48px); margin: 0 0 12px;"
    >
      Field notes
    </h1>
    <p
      style="font-size: 16px; margin: 0 0 40px; max-width: 60ch; color: color-mix(in srgb, var(--color-text) 78%, transparent);"
    >
      Occasional writing on agentic engineering, platform architecture, and leading teams through
      hard technical change.
    </p>
    <div style="display: grid; gap: 20px;">
      {
        posts.map((post) => (
          <a href={path(`/blog/${post.id}`)} style="text-decoration: none; color: inherit;">
            <div
              class="card elev-sm"
              style="display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 12px; align-items: center;"
            >
              <div>
                <div class="card-kicker">
                  {post.data.tag} · {monthYear(post.data.date)}
                </div>
                <div class="card-title">{post.data.title}</div>
                <p class="card-body">{post.data.excerpt}</p>
                <div class="card-meta">
                  <span>{post.data.readTime}</span>
                </div>
              </div>
              <Icon
                name="arrow-right"
                size={20}
                style="color: var(--color-accent-700); flex-shrink: 0;"
              />
            </div>
          </a>
        ))
      }
    </div>
  </main>
</Base>

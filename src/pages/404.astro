---
import Base from '../layouts/Base.astro';
import { path } from '../lib/paths';

// CloudFront maps both 404 and 403 to this page. S3 answers 403 rather than 404
// for a missing key under Origin Access Control, so without this mapping a bad
// URL would surface as a raw AccessDenied error.
---

<Base
  title="Page not found — Sean Teare"
  description="That page does not exist."
>
  <main style="padding: 96px 0 64px; max-width: 60ch;">
    <span
      style="display: block; font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600; color: var(--color-accent-700); margin: 0 0 16px;"
      >404</span
    >
    <h1
      style="font-family: var(--font-heading); font-weight: var(--font-heading-weight); font-size: clamp(34px, 4.5vw, 48px); line-height: 1.1; margin: 0 0 16px;"
    >
      That page doesn't exist
    </h1>
    <p
      style="font-size: 17px; line-height: 1.65; margin: 0 0 32px; color: color-mix(in srgb, var(--color-text) 82%, transparent);"
    >
      The link may be out of date, or the page may have moved. Here's the way back.
    </p>
    <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
      <a class="btn btn-primary" href={path('/')} style="text-decoration: none;">Go home</a>
      <a class="btn btn-ghost" href={path('/blog')} style="text-decoration: none;">Read the blog</a>
    </div>
  </main>
</Base>
